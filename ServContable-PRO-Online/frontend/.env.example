# URL publica del backend, siempre terminada en /api
# Si el backend sirve el frontend en el mismo dominio, puedes usar /api.
VITE_API_URL=https://api.tu-dominio.cl/api

# Mantener false para venta. El registro publico se controla tambien en backend.
VITE_ALLOW_PUBLIC_REGISTRATION=false

# Demo: poner true solo en la version demo.
VITE_DEMO_MODE=false
