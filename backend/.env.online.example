NODE_ENV=production
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=true

# Poner true si el backend tambien servira frontend/dist.
# Poner false si el frontend se publica en un hosting separado.
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist

DATABASE_URL=postgresql://usuario:password@host:5432/servcontable_pro
DATABASE_SSL=false

JWT_SECRET=cambiar_por_una_clave_segura_de_minimo_32_caracteres

ADMIN_NOMBRE=Administrador ServContable
ADMIN_EMAIL=admin@tu-dominio.cl
ADMIN_PASSWORD=cambiar_esta_clave_inicial

ALLOW_PUBLIC_REGISTRATION=false
DEMO_MODE=false

CORS_ORIGIN=https://app.tu-dominio.cl
FRONTEND_URL=https://app.tu-dominio.cl
PASSWORD_RESET_URL_BASE=https://app.tu-dominio.cl

# Configurar solo si se usaran pagos Flow en la version online.
FLOW_ENV=production
FLOW_API_BASE=https://www.flow.cl/api
FLOW_API_KEY=tu_api_key_flow
FLOW_SECRET_KEY=tu_secret_key_flow
PUBLIC_BASE_URL=https://www.tu-dominio.cl
BACKEND_PUBLIC_URL=https://app.tu-dominio.cl
FLOW_CONFIRMATION_URL=https://app.tu-dominio.cl/api/pagos-flow/webhook
FLOW_RETURN_URL=https://app.tu-dominio.cl/api/pagos-flow/retorno
